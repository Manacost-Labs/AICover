# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-only OpenRouter credential. Never prefix this with VITE_ and never
# commit a real value. OPENROUTER_ENABLED is a separate fail-closed release flag.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_ENABLED="false"

# Per-user ChatGPT sessions are encrypted on the server and bound to the
# current Cover login. Generate the key with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
COVER_CHATGPT_ENABLED="false"
COVER_CHATGPT_ORIGIN="https://cover.example.com"
COVER_CHATGPT_SESSION_KEY="GENERATE_A_32_BYTE_BASE64URL_KEY"
COVER_CHATGPT_SESSION_FILE="/var/lib/cover-image/chatgpt/sessions.enc"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase: Required for persistent storage (card library, history, favorites).
# Project Settings → API in Supabase dashboard.
# VITE_SUPABASE_URL must be the FULL project URL (https://<ref>.supabase.co), not the ref alone.
# VITE_SUPABASE_ANON_KEY: Publishable key (sb_publishable_…) or legacy anon JWT (eyJ…). NOT the secret key. NOT the URL.
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-jwt-key"
